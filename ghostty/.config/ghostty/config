# ============================================================
# Ghostty configuration — ported from kitty config
# ============================================================

# --- Environment ---
env = LANG=C.UTF-8
env = ORT_LOGGING_LEVEL=3

# --- Font ---
font-family = Monaspace Neon NF
font-size = 11

# --- Opacity ---
background-opacity = 0.9

# --- Window ---
# Kitty equivalent: window_margin_width -1 2 2 2
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true

# Kitty equivalent: hide_window_decorations yes
window-decoration = none

# Kitty equivalent: confirm_os_window_close 0
confirm-close-surface = false

# --- Command: launch tmux in every window
# Use -A -s main to attach to existing session "main" or create it
command = tmux

# --- Keybind (Kitty equivalent: map ctrl+v paste_from_clipboard) ---
keybind = ctrl+v=paste_from_clipboard

# --- Theme ---
theme = TokyoNight
